{
    "name": "Message",
    "type": "object",
    "properties": {
      "match_id": {
        "type": "string",
        "description": "ID of the match this message belongs to"
      },
      "sender_email": {
        "type": "string",
        "description": "Email of sender"
      },
      "receiver_email": {
        "type": "string",
        "description": "Email of receiver"
      },
      "message_text": {
        "type": "string"
      },
      "is_read": {
        "type": "boolean",
        "default": false
      },
      "sent_at": {
        "type": "string",
        "format": "date-time"
      }
    },
    "required": [
      "match_id",
      "sender_email",
      "receiver_email",
      "message_text"
    ]
  }